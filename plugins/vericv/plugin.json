{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "vericv",
  "version": "1.0.1",
  "description": "Evidence-grounded CV matching and tailoring without invented claims.",
  "author": {
    "name": "Cipher Technologies",
    "email": "info@ciphertechnologies.co.zw",
    "url": "https://ciphertechnologies.co.zw/plugins/vericv"
  },
  "homepage": "https://ciphertechnologies.co.zw/plugins/vericv",
  "repository": "https://github.com/Lesleykaps/vericv.git",
  "license": "MIT",
  "keywords": ["cv", "resume", "job matching", "career"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "VeriCV",
        "shortDescription": "Match and tailor CVs without invented claims.",
        "longDescription": "Compare a CV with job requirements, identify evidence-backed strengths and gaps, then create truthful ATS-friendly tailoring.",
        "developerName": "Cipher Technologies",
        "category": "Productivity",
        "websiteURL": "https://ciphertechnologies.co.zw/plugins/vericv",
        "privacyPolicyURL": "https://ciphertechnologies.co.zw/plugins/vericv/privacy",
        "termsOfServiceURL": "https://ciphertechnologies.co.zw/plugins/vericv/terms",
        "capabilities": ["Local file analysis", "CV tailoring", "File creation"],
        "defaultPrompt": [
          "Compare my CV with a job description using documented evidence.",
          "Create a truthful ATS-friendly CV for this role."
        ],
        "brandColor": "#1F6F5B"
      }
    }
  }
}
